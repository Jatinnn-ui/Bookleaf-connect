# --- Database ---
DATABASE_URL=postgresql://bookleaf:change-me@localhost:5433/bookleaf?schema=public
# Integration tests only; this database is RESET by the test run.
TEST_DATABASE_URL=postgresql://bookleaf:change-me@localhost:5433/bookleaf_test?schema=public

# --- Auth ---
# 32+ random characters, e.g. `openssl rand -hex 32`
AUTH_SECRET=
# Set to "false" only when running the production build over plain HTTP locally.
COOKIE_SECURE=true

# --- AI (server-side only; never prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=
# gemini-3.5-flash-lite is the cheapest/fastest and is the recommended default for
# this classify+draft workload. gemini-3.8-flash also works but can return 503s under load.
GEMINI_MODEL=gemini-3.5-flash-lite
# MINIMAL | LOW | MEDIUM | HIGH (empty = model default)
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_TIMEOUT_MS=12000

# --- Seed (npm run db:seed) ---
SEED_DEMO_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=BookLeaf Ops
# "true" re-hashes passwords for existing seeded users
SEED_RESET_PASSWORDS=false

# --- Docker Compose ---
POSTGRES_USER=bookleaf
POSTGRES_PASSWORD=
POSTGRES_DB=bookleaf
APP_PORT=3000

NODE_ENV=development

// BookLeaf Connect data model.
// Money is stored as Decimal(12,2) to avoid floating point drift.
// Book.status is free text so the original sample values ("In Production - Cover Design") survive intact.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ClassificationSource {
  AI
  FALLBACK
  MANUAL
}

enum AiStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author          Author?
  assignedTickets Ticket[]        @relation("AssignedAdmin")
  messages        TicketMessage[]
  notes           InternalNote[]
  auditLogs       TicketAuditLog[]
}

model Author {
  id               String   @id @default(uuid())
  externalAuthorId String   @unique
  userId           String   @unique
  phone            String?
  city             String?
  joinedDate       DateTime @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books   Book[]
  tickets Ticket[]
}

model Book {
  id                    String    @id @default(uuid())
  externalBookId        String    @unique
  authorId              String
  title                 String
  isbn                  String
  genre                 String
  publicationDate       DateTime? @db.Date
  status                String
  mrp                   Decimal?  @db.Decimal(12, 2)
  authorRoyaltyPerCopy  Decimal?  @db.Decimal(12, 2)
  totalCopiesSold       Int
  totalRoyaltyEarned    Decimal   @db.Decimal(12, 2)
  royaltyPaid           Decimal   @db.Decimal(12, 2)
  royaltyPending        Decimal   @db.Decimal(12, 2)
  lastRoyaltyPayoutDate DateTime? @db.Date
  printPartner          String?
  availableOn           String[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  author  Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([authorId])
}

model Ticket {
  id                     String               @id @default(uuid())
  ticketNumber           String               @unique
  authorId               String
  bookId                 String?
  subject                String
  description            String
  status                 TicketStatus         @default(OPEN)
  category               TicketCategory
  priority               Priority
  priorityScore          Int
  classificationSource   ClassificationSource
  aiClassificationStatus AiStatus             @default(PENDING)
  aiClassificationReason String?
  aiDraft                String?
  aiDraftGeneratedAt     DateTime?
  aiDraftError           String?
  attachmentName         String?
  assignedAdminId        String?
  resolvedAt             DateTime?
  closedAt               DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  author        Author           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book          Book?            @relation(fields: [bookId], references: [id], onDelete: SetNull)
  assignedAdmin User?            @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]
  notes         InternalNote[]
  auditLogs     TicketAuditLog[]

  @@index([authorId, createdAt])
  @@index([status, priorityScore])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([assignedAdminId])
}

// Public conversation, visible to the owning author and admins.
model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

// Admin-only notes. Stored separately so no author query can join them by accident.
model InternalNote {
  id        String   @id @default(uuid())
  ticketId  String
  adminId   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  User   @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

// Lightweight audit trail for status changes, overrides and assignment.
model TicketAuditLog {
  id        String   @id @default(uuid())
  ticketId  String
  actorId   String?
  action    String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
